# Copy to .env.local. Public browser credentials only; RLS protects all rows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never put service-role keys, database passwords, or access tokens here.

# Public VAPID key for Web Push. The private key belongs only in Supabase Edge Function secrets.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Server-only feedback email settings (also set in Vercel). Never use NEXT_PUBLIC_.
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=
# A sender on your verified Resend domain, e.g. DayFlow <feedback@your-domain.com>
FEEDBACK_FROM_EMAIL=
