# Copy to .env.local. NEXT_PUBLIC_ values are browser-safe; all other keys stay server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never prefix secret keys with NEXT_PUBLIC_ or commit .env.local.

# Public VAPID key for Web Push. The private key belongs only in Supabase Edge Function secrets.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Server-only feedback email settings (also set in Vercel). Never use NEXT_PUBLIC_.
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=
# A sender on your verified Resend domain, e.g. DayFlow <feedback@your-domain.com>
FEEDBACK_FROM_EMAIL=

# Server-only Supabase secret API key for registering deletion OTP challenges.
# Vercel: Sensitive. Never expose this key to the browser.
SUPABASE_SECRET_KEY=
