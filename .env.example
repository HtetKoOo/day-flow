# Copy to .env.local. Public browser credentials only; RLS protects all rows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never put service-role keys, database passwords, or access tokens here.

# Public VAPID key for Web Push. The private key belongs only in Supabase Edge Function secrets.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
